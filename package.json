{
  "name": "@rigerc/ink-ui",
  "version": "0.42.0",
  "description": "React component library for Ink CLIs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "tsx src/demo/index.tsx",
    "typecheck": "tsc --noEmit",
    "check:agents": "node scripts/check-agents-md.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "lint": "oxlint",
    "update:agents": "node scripts/update-agents-md.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "update:skill": "node scripts/sync-skill.mjs --write",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "peerDependencies": {
    "ink": ">=7",
    "react": ">=19"
  },
  "dependencies": {
    "@kud/glyphs": "0.4.0",
    "cli-spinners": "3.4.0",
    "figures": "6.1.0",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "ink": "8.0.0",
    "ink-testing-library": "4.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.90.0",
    "react": "19.3.0",
    "react-devtools-core": "7.0.1",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "keywords": [
    "ink",
    "cli",
    "react",
    "terminal",
    "ui",
    "components"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rigerc/ink-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rigerc/ink-ui.git"
  },
  "bugs": {
    "url": "https://github.com/rigerc/ink-ui/issues"
  }
}
